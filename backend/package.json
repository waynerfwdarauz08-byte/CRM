{
  "name": "admisiones-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "sequelize-cli db:migrate",
    "seed": "sequelize-cli db:seed:all",
    "seed:undo": "sequelize-cli db:seed:undo:all",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "demo:clean": "node ../scripts/crear-demo-limpia.cjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "mysql2": "^3.12.0",
    "sequelize": "^6.37.5",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "sequelize-cli": "^6.6.2",
    "supertest": "^7.0.0"
  }
}
